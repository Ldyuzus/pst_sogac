APP_NAME="Solicítalo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- PostgreSQL
# Con Sail el host de la base NO es 127.0.0.1: dentro del contenedor el
# servicio se llama `pgsql`. Con 127.0.0.1 Laravel se conecta consigo mismo y
# falla con "no se pudo resolver el host".
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=solicitalo
DB_USERNAME=postgres
DB_PASSWORD=secret

# Si NO usas Sail y trabajas con XAMPP o un PostgreSQL instalado en tu maquina,
# cambia la linea de arriba por:
# DB_HOST=127.0.0.1
# DB_PASSWORD=<tu clave>

# Si tu PostgreSQL local ya ocupa el puerto 5432 y Sail lo necesita tambien,
# cambia el puerto donde se publica la base (no el de dentro del contenedor):
# FORWARD_DB_PORT=5433

APP_PORT=80

BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# MAIL_MAILER=log escribe los correos en storage/logs/laravel.log.
# Para enviar correo real hay que credenciales SMTP de la universidad.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"